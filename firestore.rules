rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Hierarquia: gestor > admin > colaborador > pendente (services/auth/papeis.ts).
    // O e-mail master verificado (o mesmo do CFI) é sempre gestor.
    function isSignedIn()  { return request.auth != null; }
    function isMaster()    { return isSignedIn() && request.auth.token.get('email', '') == 'junior@spassessoriacontabil.com.br'
                                    && request.auth.token.get('email_verified', false) == true; }
    function userDoc()     { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isApproved()  { return isMaster() || (isSignedIn() && userDoc().role in ['gestor','admin','colaborador']); }
    function isAdmin()     { return isMaster() || (isSignedIn() && userDoc().role in ['gestor','admin']); }
    function isGestor()    { return isMaster() || (isSignedIn() && userDoc().role == 'gestor'); }

    // Carteira (services/carteira): o gestor vê todas as empresas; os demais,
    // as da carteira_acessos/{uid}.empresaIds e as que eles mesmos cadastraram.
    function carteiraPath(uid) { return /databases/$(database)/documents/carteira_acessos/$(uid); }
    function naCarteira(empId) { return exists(carteiraPath(request.auth.uid))
                                    && empId in get(carteiraPath(request.auth.uid)).data.empresaIds; }
    function criouEmpresa(empId) { return exists(/databases/$(database)/documents/empresas/$(empId))
                                    && get(/databases/$(database)/documents/empresas/$(empId)).data.criadoPor == request.auth.uid; }
    function podeEmpresa(empId) { return isGestor()
                                    || (isApproved() && empId is string && (naCarteira(empId) || criouEmpresa(empId))); }
    // Id gravado nos documentos da empresa: o automático do Firestore (20 letras e números). Ids com outros caracteres
    // virariam expressão regular nas regras dos documentos que começam pelo id da empresa (auditoria de 10/2026).
    function idEmpresaValido(empId) { return empId is string && empId.matches('^[A-Za-z0-9]{20}$'); }
    // Documento por empresa: cria e altera só quem pode na empresa, e a alteração não troca a empresa do documento.
    function gravaNaEmpresa() { return podeEmpresa(request.resource.data.empresaId)
                                    && (resource == null || (podeEmpresa(resource.data.empresaId)
                                                             && request.resource.data.empresaId == resource.data.empresaId)); }

    // Fim de mês: período encerrado (fechamentos/{empresa}_{AAAA-MM}) fica somente leitura até o gestor reabrir.
    function fechamentoPath(empId, comp) { return /databases/$(database)/documents/fechamentos/$(empId + '_' + comp); }
    function periodoEncerrado(empId, comp) { return comp is string && exists(fechamentoPath(empId, comp))
                                    && get(fechamentoPath(empId, comp)).data.situacao == 'encerrado'; }
    function mesDaData(d) { return d is string && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') ? d.split('-')[0] + '-' + d.split('-')[1] : ''; }

    match /users/{uid} {
      allow read:   if isSignedIn() && (request.auth.uid == uid || isAdmin());
      // Lista (e-mails, nomes e papéis da equipe) só para quem aprova usuários (auditoria de 10/2026).
      allow list:   if isAdmin();
      // Perfil novo nasce pendente; só o master nasce gestor. O e-mail é o do login (não dá para se passar por outro).
      allow create: if isSignedIn() && request.auth.uid == uid
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.get('email', '') == request.auth.token.get('email', '')
                    && (request.resource.data.role == 'pendente'
                        || (request.resource.data.role == 'gestor' && isMaster()));
      // Gestor muda qualquer outro; admin só aprova/rebaixa entre pendente e
      // colaborador (nunca o próprio perfil, nunca outro admin ou gestor).
      // No próprio perfil, só o master, e só para se tornar gestor.
      allow update: if (isGestor() && request.auth.uid != uid)
                    || (isMaster() && request.auth.uid == uid && request.resource.data.role == 'gestor'
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']))
                    || (isAdmin() && request.auth.uid != uid
                        && resource.data.role in ['pendente','colaborador']
                        && request.resource.data.role in ['pendente','colaborador']
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role','approvedAt','approvedBy']));
      allow delete: if (isGestor() && request.auth.uid != uid)
                    || (isAdmin() && request.auth.uid != uid && resource.data.role in ['pendente','colaborador']);
    }

    // Empresas: v2.2.0 — todo colaborador aprovado vê todas as empresas.
    // Edição continua restrita ao criador OU admin; exclusão, só o gestor.
    // Restrição por empresa específica fica para a carteira do colaborador.
    match /empresas/{empresaId} {
      allow get:    if isGestor()
                    || (isApproved() && (naCarteira(empresaId) || resource.data.criadoPor == request.auth.uid));
      // Lista inteira só o gestor; os demais leem a carteira empresa por empresa
      // e listam as que cadastraram (consulta por criadoPor).
      allow list:   if isGestor()
                    || (isApproved() && resource.data.criadoPor == request.auth.uid);
      allow create: if isApproved()
                    && idEmpresaValido(empresaId)
                    && request.resource.data.criadoPor == request.auth.uid
                    && request.resource.data.cnpj is string
                    && request.resource.data.cnpj.matches('^[0-9]{14}$')
                    && request.resource.data.codigoSage.matches('^[0-9]{1,6}$')
                    && request.resource.data.razaoSocial is string
                    && request.resource.data.nomeFantasia is string
                    && request.resource.data.codigoSage is string
                    && chaveDaEmpresa('sage_' + request.resource.data.codigoSage, empresaId)
                    && chaveDaEmpresa('cnpj_' + request.resource.data.cnpj, empresaId);
      allow update: if (isGestor()
                    || (isApproved() && (
                         resource.data.criadoPor == request.auth.uid
                         || (isAdmin() && naCarteira(empresaId))
                       ))
                    // Quem tem a empresa na carteira (colaborador incluído) grava só o que a operação da folha
                    // usa: contas e número do arquivo bancário, contato de envio do pacote e parâmetros do
                    // eSocial da folha e do cálculo (arredondamento). Os dados cadastrais continuam com o gestor,
                    // quem cadastrou e o admin.
                    || (podeEmpresa(empresaId)
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['contasPagamento', 'contatoEnvio', 'esocialFolha', 'parametrosFolha', 'procuracaoFgts', 'atualizadoEm'])))
                    // Quem cadastrou não muda (dá acesso permanente; auditoria de 10/2026), a não ser pelo gestor.
                    && (request.resource.data.get('criadoPor', null) == resource.data.get('criadoPor', null) || isGestor())
                    // Trocar o código SAGE ou o CNPJ exige reservar a chave nova, no formato certo.
                    && (request.resource.data.cnpj == resource.data.cnpj || request.resource.data.cnpj.matches('^[0-9]{14}$'))
                    && (request.resource.data.codigoSage == resource.data.codigoSage
                        || chaveDaEmpresa('sage_' + request.resource.data.codigoSage, empresaId))
                    && (request.resource.data.cnpj == resource.data.cnpj
                        || chaveDaEmpresa('cnpj_' + request.resource.data.cnpj, empresaId));
      allow delete: if isGestor();
    }

    // Documento por CNPJ (folha_*, ponto_layouts): a empresa dona do CNPJ pela chave única (empresas_unicos/cnpj_…).
    // Sem a chave reservada, só o admin. Chave que não é CNPJ (modelos como "EDUCATI"): lê quem é aprovado, grava o admin.
    function unicoCnpj(c) { return /databases/$(database)/documents/empresas_unicos/$('cnpj_' + c); }
    function podeCnpj(c) { return isGestor() || (isApproved() && c is string && c.matches('^[0-9]{14}$') && exists(unicoCnpj(c)) && podeEmpresa(get(unicoCnpj(c)).data.empresaId))
                                  || (isAdmin() && c is string && c.matches('^[0-9]{14}$') && !exists(unicoCnpj(c))); }
    function leCliente(c) { return c.matches('^[0-9]{14}$') ? podeCnpj(c) : isApproved(); }
    function gravaCliente(c) { return c.matches('^[0-9]{14}$') ? podeCnpj(c) : isAdmin(); }

    // Código SAGE e CNPJ únicos (06/10/2026): empresas_unicos/{sage_0000 | cnpj_…}
    // aponta a empresa dona. A chave nasce no mesmo lote da empresa, não troca
    // de dono e só é liberada quando a empresa deixa de usá-la (ou é excluída).
    function chaveDaEmpresa(chave, empId) {
      return existsAfter(/databases/$(database)/documents/empresas_unicos/$(chave))
          && getAfter(/databases/$(database)/documents/empresas_unicos/$(chave)).data.empresaId == empId;
    }
    match /empresas_unicos/{chave} {
      function empresaDepois(empId) { return getAfter(/databases/$(database)/documents/empresas/$(empId)).data; }
      function usaChave(empId) {
        return existsAfter(/databases/$(database)/documents/empresas/$(empId))
            && (chave == 'sage_' + empresaDepois(empId).codigoSage || chave == 'cnpj_' + empresaDepois(empId).cnpj);
      }
      // O dono só para quem pode na empresa dona (senão a chave virava consulta CNPJ/SAGE → id de qualquer empresa).
      // A chave que não existe pode ser consultada (é o que diz que o CNPJ ou o código está livre).
      allow get:    if isApproved() && (resource == null || isAdmin() || podeEmpresa(resource.data.empresaId));
      allow list:   if isGestor();
      allow create: if isApproved()
                    && request.resource.data.chave == chave
                    && request.resource.data.empresaId is string
                    && request.resource.data.criadoPor == request.auth.uid
                    && usaChave(request.resource.data.empresaId);
      allow update: if false;
      allow delete: if isApproved() && !usaChave(resource.data.empresaId);
    }

    // Carteira: o gestor monta a de qualquer um; o admin, só a de colaboradores,
    // e só mexendo em empresas da carteira dele. Ninguém mexe na própria (fora o gestor).
    match /carteira_acessos/{uid} {
      function antesIds() { return resource == null ? [] : resource.data.empresaIds; }
      function mudancas() { return request.resource.data.empresaIds.toSet().difference(antesIds().toSet())
                                     .union(antesIds().toSet().difference(request.resource.data.empresaIds.toSet())); }
      function formatoOk() { return request.resource.data.uid == uid
                                   && request.resource.data.empresaIds is list
                                   && request.resource.data.empresaIds.size() <= 5000
                                   && request.resource.data.atualizadoPor == request.auth.uid; }
      allow get:    if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list:   if isAdmin();
      allow create, update: if formatoOk() && (
                       isGestor()
                       || (isAdmin() && request.auth.uid != uid
                           && get(/databases/$(database)/documents/users/$(uid)).data.role == 'colaborador'
                           && exists(carteiraPath(request.auth.uid))
                           && mudancas().hasOnly(get(carteiraPath(request.auth.uid)).data.empresaIds))
                    );
      allow delete: if isGestor();
    }

    match /folha_catalogo/{docId} {
      allow read:  if isApproved();
      allow write: if isAdmin();
    }

    // Seleção, mapeamento e histórico do apontamento: por cliente (o CNPJ), só da carteira (auditoria de 10/2026).
    match /folha_selecoes_eventos/{cliente} {
      allow read:   if leCliente(cliente);
      allow create, update: if gravaCliente(cliente);
      allow delete: if isAdmin() && gravaCliente(cliente);
    }

    match /folha_mapeamentos/{cliente} {
      allow read:   if leCliente(cliente);
      allow create, update: if gravaCliente(cliente);
      allow delete: if isAdmin() && gravaCliente(cliente);
    }

    match /folha_historico/{cliente}/exportacoes/{logId} {
      allow read:   if leCliente(cliente);
      allow create: if leCliente(cliente);
      allow update, delete: if isAdmin() && gravaCliente(cliente);
    }

    match /users/{uid}/cache/{key} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    match /folha_eventos_audit/{auditId} {
      allow read: if isApproved();
      allow create: if isApproved();
      allow update, delete: if false;
    }

    match /folha_perfis_colunas/{cnpj} {
      allow read:   if leCliente(cnpj);
      allow create, update: if gravaCliente(cnpj);
      allow delete: if isAdmin() && gravaCliente(cnpj);
    }
    // ===== Ponto Eletronico =====

    // Catalogo de modelos de ponto (ACJEF, DIMEP, Henry, Ahgora, etc).
    // Leitura: qualquer usuario aprovado. Escrita: so admin (catalogo compartilhado).
    match /ponto_modelos/{modeloId} {
      allow read:   if isApproved();
      allow list:   if isApproved();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Layouts de ponto por empresa (CNPJ + cadastro SAGE).
    // Mesma logica de empresas: usuario aprovado le e escreve.
    // Id = CNPJ_códigoSAGE: só da carteira (pela empresa dona do CNPJ).
    match /ponto_layouts/{layoutId} {
      allow get:    if podeCnpj(layoutId.split('_')[0]);
      allow list:   if podeCnpj(resource.data.cnpj);
      allow create, update: if podeCnpj(layoutId.split('_')[0]) && request.resource.data.cnpj == layoutId.split('_')[0];
      allow delete: if isAdmin() && podeCnpj(layoutId.split('_')[0]);
    }



    // ===== eSocial Monitor =====

    match /esocial_eventos/{eventoId} {
      allow read, list: if podeEmpresa(resource.data.empresaId);
      allow create:     if podeEmpresa(request.resource.data.empresaId);
      allow update:     if podeEmpresa(resource.data.empresaId) && podeEmpresa(request.resource.data.empresaId);
      allow delete:     if isAdmin() && podeEmpresa(resource.data.empresaId);
    }

    match /esocial_fgts/{registroId} {
      allow read, list: if podeEmpresa(resource.data.empresaId);
      allow create:     if podeEmpresa(request.resource.data.empresaId);
      allow update:     if podeEmpresa(resource.data.empresaId) && podeEmpresa(request.resource.data.empresaId);
      allow delete:     if isAdmin() && podeEmpresa(resource.data.empresaId);
    }

    match /esocial_teses/{teseId} {
      allow read, list: if podeEmpresa(resource.data.empresaId);
      allow create:     if podeEmpresa(request.resource.data.empresaId);
      allow update:     if podeEmpresa(resource.data.empresaId) && podeEmpresa(request.resource.data.empresaId);
      allow delete:     if isAdmin() && podeEmpresa(resource.data.empresaId);
    }

    // O log lista todas as empresas: só o admin (auditoria de 10/2026).
    match /esocial_audit/{logId} {
      allow read, list: if isAdmin();
      allow create:     if isApproved();
      allow update, delete: if false;
    }

    // ===== Cadastros (Arquivos do IOB Office) =====
    // Toda gravação leva o autor; a auditoria é só inclusão.

    // Ids que começam pelo id da empresa: comparados por partes (split), nunca como expressão regular montada
    // com dado do cliente (auditoria de 10/2026).
    match /cadastro_funcionarios/{fichaId} {
      allow read, list: if podeEmpresa(resource.data.empresaId);
      allow create, update: if gravaNaEmpresa()
                    && request.resource.data.atualizadoPor == request.auth.uid
                    && request.resource.data.empresaId is string
                    && request.resource.data.cpf is string
                    && request.resource.data.matriculaEsocial is string
                    && fichaId.split('_').size() >= 3
                    && fichaId.split('_')[0] == request.resource.data.empresaId
                    && fichaId.split('_')[1] == request.resource.data.cpf;
      allow delete: if isAdmin() && podeEmpresa(resource.data.empresaId);
    }

    match /cadastro_sindicatos/{cnpj} {
      allow read, list: if isApproved();
      // Sindicato é de todas as empresas: o novo qualquer aprovado cadastra; mudar o existente é do admin.
      allow create: if isApproved()
                    && request.resource.data.atualizadoPor == request.auth.uid
                    && request.resource.data.cnpj == cnpj
                    && request.resource.data.nome is string;
      allow update: if isAdmin()
                    && request.resource.data.atualizadoPor == request.auth.uid
                    && request.resource.data.cnpj == cnpj
                    && request.resource.data.nome is string;
      allow delete: if isAdmin();
    }

    // Tabela legal vale para todas as empresas: criar, corrigir ou apagar é do admin; sem norma não entra.
    match /cadastro_tabelas_legais/{tabelaId} {
      allow read, list: if isApproved();
      allow create: if isAdmin()
                    && request.resource.data.atualizadoPor == request.auth.uid
                    && request.resource.data.norma is string
                    && request.resource.data.norma.size() >= 5
                    && request.resource.data.vigencia is string;
      allow update, delete: if isAdmin();
    }

    // Horários e afastamentos: id começa pelo id da empresa (empresa_código, empresa_cpf_matrícula_data).
    match /cadastro_horarios/{horarioId} {
      allow read, list: if podeEmpresa(resource.data.empresaId);
      allow create, update: if gravaNaEmpresa()
                    && request.resource.data.atualizadoPor == request.auth.uid
                    && request.resource.data.empresaId is string
                    && request.resource.data.codigo is string
                    && horarioId.split('_').size() >= 2
                    && horarioId.split('_')[0] == request.resource.data.empresaId;
      allow delete: if isAdmin() && podeEmpresa(resource.data.empresaId);
    }

    match /cadastro_afastamentos/{afastamentoId} {
      allow read, list: if podeEmpresa(resource.data.empresaId);
      allow create, update: if gravaNaEmpresa()
                    && request.resource.data.atualizadoPor == request.auth.uid
                    && request.resource.data.empresaId is string
                    && request.resource.data.dtInicio is string
                    && request.resource.data.dtInicio.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                    && afastamentoId.split('_').size() >= 4
                    && afastamentoId.split('_')[0] == request.resource.data.empresaId
                    && afastamentoId.split('_')[1] == request.resource.data.cpf
                    && afastamentoId.split('_')[afastamentoId.split('_').size() - 1] == request.resource.data.dtInicio
                    && !periodoEncerrado(request.resource.data.empresaId, mesDaData(request.resource.data.dtInicio))
                    && (resource == null || !periodoEncerrado(resource.data.empresaId, mesDaData(resource.data.dtInicio)));
      allow delete: if isAdmin() && podeEmpresa(resource.data.empresaId)
                    && !periodoEncerrado(resource.data.empresaId, mesDaData(resource.data.dtInicio));
    }

    // Rubricas do S-1010 por empresa: empresa_tabela_código.
    match /cadastro_rubricas/{rubricaId} {
      allow read, list: if podeEmpresa(resource.data.empresaId);
      allow create, update: if gravaNaEmpresa()
                    && request.resource.data.atualizadoPor == request.auth.uid
                    && request.resource.data.empresaId is string
                    && request.resource.data.codRubr is string
                    && rubricaId.split('_').size() >= 2
                    && rubricaId.split('_')[0] == request.resource.data.empresaId;
      allow delete: if isAdmin() && podeEmpresa(resource.data.empresaId);
    }

    // Enquadramento previdenciário por empresa e vigência: empresa_AAAA-MM.
    match /cadastro_enquadramentos/{enqId} {
      allow read, list: if podeEmpresa(resource.data.empresaId);
      allow create, update: if gravaNaEmpresa()
                    && request.resource.data.atualizadoPor == request.auth.uid
                    && request.resource.data.empresaId is string
                    && request.resource.data.vigencia is string
                    && request.resource.data.vigencia.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
                    && request.resource.data.regime in ['normal', 'simples-iv', 'simples']
                    && enqId == request.resource.data.empresaId + '_' + request.resource.data.vigencia;
      allow delete: if isAdmin() && podeEmpresa(resource.data.empresaId);
    }

    // Lotes do eSocial transmitidos pelo cofre do CFI (o CFI confere a carteira
    // de novo antes de transmitir). Só Ids, tipos, recibos e ocorrências; o
    // registro de uma entrega ao eSocial não se apaga, e a consulta só
    // atualiza o resultado.
    match /esocial_envios/{envioId} {
      allow read, list: if podeEmpresa(resource.data.empresaId);
      // Saúde do eSocial: o lote é registrado antes de sair ("transmitindo", sem protocolo).
      allow create: if podeEmpresa(request.resource.data.empresaId)
                    && request.resource.data.enviadoPor == request.auth.uid
                    && request.resource.data.empresaId is string
                    && request.resource.data.protocolo is string
                    && request.resource.data.tpAmb in [1, 2]
                    && request.resource.data.eventos is list
                    && request.resource.data.eventos.size() <= 50
                    && request.resource.data.situacao in ['transmitindo', 'enviado', 'recusado']
                    && (request.resource.data.situacao != 'transmitindo' || request.resource.data.protocolo == '');
      // 1) Resposta do envio: só quem transmitiu, uma vez, sem tirar nem pôr eventos.
      // 2) Consulta: só completa o lote ainda sem resultado, sem tirar nem pôr eventos: o registro de uma entrega
      //    processada não muda (auditoria de 10/2026).
      // 3) Sem resposta: conferido no eSocial (recibos achados) ou liberado para reenvio depois de 30 min.
      allow update: if podeEmpresa(resource.data.empresaId)
                    && request.resource.data.eventos is list
                    && request.resource.data.eventos.size() == resource.data.eventos.size()
                    && (
                      (resource.data.situacao == 'transmitindo'
                        && resource.data.enviadoPor == request.auth.uid
                        && request.resource.data.situacao in ['enviado', 'recusado', 'sem-resposta', 'nao-recebido']
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['situacao', 'protocolo', 'dhRecepcao', 'transmissor', 'grupo', 'cdResposta', 'descResposta', 'ocorrencias', 'respondidoEm', 'erroEnvio']))
                      || (resource.data.situacao in ['enviado', 'em-processamento']
                        && request.resource.data.situacao in ['enviado', 'em-processamento', 'processado', 'recusado']
                        && request.resource.data.consultadoPor == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['situacao', 'cdResposta', 'descResposta', 'ocorrencias', 'eventos', 'consultadoEm', 'consultadoPor', 'consultadoPorEmail', 'consultas']))
                      || ((resource.data.situacao == 'sem-resposta'
                           || (resource.data.situacao == 'transmitindo' && request.time > resource.data.enviadoEm + duration.value(3, 'm')))
                        && request.resource.data.verificadoPor == request.auth.uid
                        && (request.resource.data.situacao in ['sem-resposta', 'processado']
                            || (request.resource.data.situacao == 'nao-recebido' && request.time > resource.data.enviadoEm + duration.value(30, 'm')))
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['situacao', 'eventos', 'verificadoEm', 'verificadoPor', 'verificadoPorEmail']))
                    );
      allow delete: if false;
    }

    // Calendário de obrigações: o que já foi entregue (ou não se aplica) na
    // empresa e competência. Id = empresa_obrigação-AAAA-MM. Desfazer a
    // marcação é de quem trabalha na empresa (fica na auditoria). "competencia"
    // é a de trabalho (a do 13º anual leva só o ano no id da obrigação).
    match /obrigacoes_status/{marcacaoId} {
      allow read, list: if podeEmpresa(resource.data.empresaId);
      allow create, update: if gravaNaEmpresa()
                    && request.resource.data.atualizadoPor == request.auth.uid
                    && request.resource.data.empresaId is string
                    && request.resource.data.obrigacao is string
                    && request.resource.data.competencia is string
                    && request.resource.data.competencia.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
                    && request.resource.data.obrigacao.matches('^[a-z0-9-]{3,80}$')
                    && request.resource.data.status in ['entregue', 'nao-se-aplica']
                    && marcacaoId == request.resource.data.empresaId + '_' + request.resource.data.obrigacao;
      allow delete: if podeEmpresa(resource.data.empresaId);
    }

    // ===== Cálculo (Fase 3) =====
    // Movimento do mês por funcionário: id = idDaFicha_AAAA-MM; a ficha começa pelo id da empresa.
    match /calculo_movimentos/{movId} {
      allow read, list: if podeEmpresa(resource.data.empresaId);
      allow create, update: if gravaNaEmpresa()
                    && request.resource.data.atualizadoPor == request.auth.uid
                    && request.resource.data.empresaId is string
                    && request.resource.data.fichaId is string
                    && request.resource.data.competencia is string
                    && request.resource.data.competencia.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
                    && request.resource.data.movimento is map
                    && movId == request.resource.data.fichaId + '_' + request.resource.data.competencia
                    && request.resource.data.fichaId.split('_').size() >= 3
                    && request.resource.data.fichaId.split('_')[0] == request.resource.data.empresaId
                    && !periodoEncerrado(request.resource.data.empresaId, request.resource.data.competencia)
                    && (resource == null || !periodoEncerrado(resource.data.empresaId, resource.data.competencia));
      allow delete: if isAdmin() && podeEmpresa(resource.data.empresaId)
                    && !periodoEncerrado(resource.data.empresaId, resource.data.competencia);
    }

    // ===== Folha gravada =====
    // Holerites do mês guardados (como o processamento do SAGE): grava quem trabalha na empresa, só com a competência
    // aberta no Fim de mês; encerrada, a folha gravada fica como está. Id: empresa_AAAA-MM.
    match /folhas_gravadas/{folhaId} {
      allow read: if podeEmpresa(folhaId.split('_')[0]);
      allow create, update: if podeEmpresa(request.resource.data.empresaId)
                    && folhaId == request.resource.data.empresaId + '_' + request.resource.data.competencia
                    && request.resource.data.competencia.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
                    && request.resource.data.gravadoPor == request.auth.uid
                    && !periodoEncerrado(request.resource.data.empresaId, request.resource.data.competencia);
      allow delete: if false;
      match /holerites/{fichaId} {
        allow read: if podeEmpresa(folhaId.split('_')[0]);
        allow create, update: if podeEmpresa(folhaId.split('_')[0])
                      && request.resource.data.empresaId == folhaId.split('_')[0]
                      && request.resource.data.competencia == folhaId.split('_')[1]
                      && request.resource.data.fichaId == fichaId
                      && fichaId.split('_')[0] == request.resource.data.empresaId
                      && request.resource.data.resultado is map
                      && !periodoEncerrado(folhaId.split('_')[0], folhaId.split('_')[1]);
        allow delete: if podeEmpresa(folhaId.split('_')[0]) && !periodoEncerrado(folhaId.split('_')[0], folhaId.split('_')[1]);
      }
    }

    // ===== CRM do DP (Jotform) =====
    // Gravado só pelo job de sincronização (conta de serviço). A empresa: quem pode no CNPJ; o CRM inteiro e o resumo:
    // gestor e admin (montam as carteiras). A ligação responsável do CRM → usuário: gestor e admin.
    match /crm_dp/{documento} {
      allow get: if isAdmin() || (documento.matches('^[0-9]{14}$') && podeCnpj(documento));
      allow list: if isAdmin();
      allow write: if false;
    }
    match /crm_dp_meta/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /crm_dp_mapa/{id} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && id == 'colaboradores'
                    && request.resource.data.keys().size() <= 200;
      allow delete: if false;
    }

    // ===== Saúde do eSocial: monitor do leiaute =====
    // Gravado só pelo job agendado (conta de serviço); todo aprovado lê.
    match /esocial_monitor/{id} {
      allow read: if isApproved();
      allow write: if false;
    }

    // ===== Contratos e modelos de documentos =====
    // Do escritório (empresaId ''): todos os aprovados leem, gestor e admin gravam. Da empresa: quem pode na empresa.
    // A gravação leva o autor e não troca o dono (escritório ↔ empresa) do modelo.
    function modeloValido() {
      let d = request.resource.data;
      return d.keys().hasOnly(['titulo', 'categoria', 'corpo', 'empresaId', 'origem', 'atualizadoPor', 'atualizadoPorEmail', 'atualizadoEm'])
        && d.titulo is string && d.titulo.size() > 0 && d.titulo.size() <= 120
        && d.categoria in ['contrato', 'termo', 'disciplinar', 'desligamento', 'declaracao', 'outro']
        && d.corpo is string && d.corpo.size() <= 200000
        && d.origem in ['consultor', 'sage', 'base']
        && d.empresaId is string
        && d.atualizadoPor == request.auth.uid;
    }
    function gravaModelo(empId) { return empId == '' ? isAdmin() : podeEmpresa(empId); }
    match /modelos_documentos/{id} {
      allow read: if resource.data.empresaId == '' ? isApproved() : podeEmpresa(resource.data.empresaId);
      allow create: if modeloValido() && gravaModelo(request.resource.data.empresaId);
      allow update: if modeloValido() && gravaModelo(resource.data.empresaId)
                    && request.resource.data.empresaId == resource.data.empresaId;
      allow delete: if gravaModelo(resource.data.empresaId);
    }

    // ===== Demissões: histórico das prévias de rescisão =====
    // Quem pode na empresa cria e muda a situação; os números da prévia não mudam depois de gravados; nada se apaga.
    function previaValida() {
      let d = request.resource.data;
      return d.keys().hasOnly(['empresaId', 'fichaId', 'nome', 'cenarios', 'resumos', 'saldoFgts', 'adiantamento13', 'observacao', 'situacao', 'escolhido', 'criadoPor', 'criadoPorEmail', 'criadoEm', 'atualizadoPor', 'atualizadoPorEmail', 'atualizadoEm'])
        && d.empresaId is string && d.fichaId is string && d.nome is string && d.nome.size() <= 120
        && d.cenarios is list && d.cenarios.size() >= 1 && d.cenarios.size() <= 4
        && d.resumos is list && d.resumos.size() == d.cenarios.size()
        && (d.saldoFgts == null || d.saldoFgts is int) && (d.adiantamento13 == null || d.adiantamento13 is int)
        && d.observacao is string && d.observacao.size() <= 1000
        && d.situacao in ['previa', 'enviada', 'escolhida', 'descartada']
        && (d.escolhido == null || (d.escolhido is int && d.escolhido >= 0 && d.escolhido < d.cenarios.size()));
    }
    match /demissoes_previas/{id} {
      allow read: if podeEmpresa(resource.data.empresaId);
      allow create: if previaValida() && podeEmpresa(request.resource.data.empresaId)
                    && request.resource.data.criadoPor == request.auth.uid && request.resource.data.situacao == 'previa';
      allow update: if previaValida() && podeEmpresa(resource.data.empresaId)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['situacao', 'escolhido', 'atualizadoPor', 'atualizadoPorEmail', 'atualizadoEm'])
                    && request.resource.data.atualizadoPor == request.auth.uid;
      allow delete: if false;
    }

    // ===== Efetivação das rescisões: passos manuais (pagamento, guia do FGTS, seguro, documentos) =====
    // Id = ficha_data. Quem pode na empresa marca; a empresa e o desligamento não mudam; nada se apaga.
    function efetivacaoValida(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['empresaId', 'fichaId', 'data', 'passos', 'atualizadoPor', 'atualizadoEm'])
        && d.empresaId is string && d.fichaId is string && d.data is string && d.data.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && id == d.fichaId + '_' + d.data
        && d.passos is map && d.passos.keys().hasOnly(['ficha', 's2299', 'pagamento', 's1210', 'fgts', 'seguro', 'documentos'])
        && d.atualizadoPor == request.auth.uid;
    }
    match /rescisoes_efetivacao/{id} {
      allow read: if podeEmpresa(resource.data.empresaId);
      allow create: if efetivacaoValida(id) && podeEmpresa(request.resource.data.empresaId);
      allow update: if efetivacaoValida(id) && podeEmpresa(resource.data.empresaId)
                    && request.resource.data.empresaId == resource.data.empresaId;
      allow delete: if false;
    }

    // ===== S-1010 pelo Consultor: pedidos de inclusão, alteração e exclusão de rubricas =====
    // Id = empresa_auto. Quem pode na empresa cria e edita o rascunho; aplicado (aceito no eSocial) e descartado
    // são finais; a empresa e o autor não mudam; nada se apaga.
    function pedidoS1010Valido(id) {
      let d = request.resource.data;
      return d.empresaId is string && id.split('_')[0] == d.empresaId
        && d.acao in ['inclusao', 'alteracao', 'exclusao']
        && d.codRubr is string && d.codRubr.size() > 0 && d.codRubr.size() <= 30
        && d.ideTabRubr is string && d.ideTabRubr.size() > 0 && d.ideTabRubr.size() <= 8
        && d.iniValid is string && d.iniValid.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && d.situacao in ['rascunho', 'aplicado', 'descartado'] && d.recibo is string
        && d.atualizadoPor == request.auth.uid;
    }
    match /esocial_s1010/{id} {
      allow read: if podeEmpresa(resource.data.empresaId);
      allow create: if pedidoS1010Valido(id) && podeEmpresa(request.resource.data.empresaId)
                    && request.resource.data.situacao == 'rascunho' && request.resource.data.criadoPor == request.auth.uid;
      allow update: if pedidoS1010Valido(id) && podeEmpresa(resource.data.empresaId) && resource.data.situacao == 'rascunho'
                    && request.resource.data.empresaId == resource.data.empresaId
                    && request.resource.data.criadoPor == resource.data.criadoPor;
      allow delete: if false;
    }

    // ===== Fim de mês =====
    // Encerra quem trabalha na empresa (a lista de conferência fica gravada); só o gestor reabre, com o motivo.
    // Reencerrar depois da alteração: de novo quem trabalha na empresa. Nada se apaga.
    match /fechamentos/{fechId} {
      allow get: if podeEmpresa(fechId.split('_')[0]);
      allow list: if podeEmpresa(resource.data.empresaId);
      allow create, update: if podeEmpresa(request.resource.data.empresaId)
                    && fechId == request.resource.data.empresaId + '_' + request.resource.data.competencia
                    && request.resource.data.competencia.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
                    && (resource == null || (resource.data.empresaId == request.resource.data.empresaId
                                             && resource.data.competencia == request.resource.data.competencia))
                    && (
                      (request.resource.data.situacao == 'encerrado'
                        && (resource == null || resource.data.situacao == 'reaberto')
                        && request.resource.data.encerradoPor == request.auth.uid
                        && request.resource.data.checklist is map)
                      || (request.resource.data.situacao == 'reaberto' && resource != null && resource.data.situacao == 'encerrado'
                        && isGestor()
                        && request.resource.data.reabertoPor == request.auth.uid
                        && request.resource.data.motivoReabertura is string && request.resource.data.motivoReabertura.size() >= 10)
                    );
      allow delete: if false;
    }
    // Pedido de reabertura: quem trabalha na empresa pede (período encerrado, com motivo); o gestor aprova ou recusa.
    match /fechamentos_pedidos/{pedidoId} {
      allow read, list: if podeEmpresa(resource.data.empresaId);
      allow create: if podeEmpresa(request.resource.data.empresaId)
                    && periodoEncerrado(request.resource.data.empresaId, request.resource.data.competencia)
                    && request.resource.data.situacao == 'pendente'
                    && request.resource.data.pedidoPor == request.auth.uid
                    && request.resource.data.motivo is string && request.resource.data.motivo.size() >= 10
                    && request.resource.data.keys().hasOnly(['empresaId', 'empresaNome', 'competencia', 'motivo', 'situacao', 'pedidoPor', 'pedidoPorEmail', 'pedidoEm']);
      allow update: if isGestor() && resource.data.situacao == 'pendente'
                    && request.resource.data.situacao in ['aprovado', 'recusado']
                    && request.resource.data.decididoPor == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['situacao', 'decididoPor', 'decididoPorEmail', 'decididoEm', 'resposta']);
      allow delete: if false;
    }

    // Registro de guarda dos backups do IOB SAGE: inventário (nome, tamanho,
    // SHA-256, local), sem o conteúdo. Só o gestor registra; ninguém altera.
    match /backups_guarda/{sha} {
      allow read, list: if isAdmin();
      allow create: if isGestor()
                    && sha.matches('^[0-9a-f]{64}$')
                    && request.resource.data.sha256 == sha
                    && request.resource.data.registradoPor == request.auth.uid
                    && request.resource.data.arquivo is string && request.resource.data.arquivo.size() > 0
                    && request.resource.data.tamanho is int && request.resource.data.tamanho > 0
                    && request.resource.data.dataBackup is string
                    && request.resource.data.empresas is list
                    && request.resource.data.localGuarda is string && request.resource.data.localGuarda.size() > 0
                    && request.resource.data.keys().hasOnly(['sha256', 'arquivo', 'tamanho', 'dataBackup', 'empresas', 'localGuarda', 'observacao', 'registradoPor', 'registradoPorEmail', 'registradoEm']);
      allow update, delete: if false;
    }

    // A auditoria guarda os valores alterados (a ficha inteira na criação): lê quem pode na empresa do registro.
    // Sindicatos e tabelas legais (sem empresa) todos leem; o resto (carteira) só o admin (auditoria de 10/2026).
    match /cadastro_audit/{logId} {
      allow read, list: if isGestor()
                    || (resource.data.empresaId is string && podeEmpresa(resource.data.empresaId))
                    || (resource.data.colecao in ['cadastro_sindicatos', 'cadastro_tabelas_legais'] && isApproved())
                    || (resource.data.colecao == 'carteira_acessos' && isAdmin());
      allow create: if isApproved() && request.resource.data.autor == request.auth.uid
                    && (request.resource.data.get('empresaId', null) == null || podeEmpresa(request.resource.data.empresaId));
      allow update, delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}

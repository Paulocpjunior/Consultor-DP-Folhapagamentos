rules_version = '2';
// Convenções coletivas: o PDF de cada uma, enviado em Cadastros › Sindicatos (regra abaixo).
// O Storage deste projeto só guardava certificados digitais (.pfx). O cofre
// único agora é o do CFI (arquivo e senha cifrados), e o renovado sobe pelo
// app Legal: este app não grava mais certificado. Ficam só para o gestor
// LER os arquivos antigos (conferir que estão no cofre antes de apagá-los
// pelo console); ninguém grava.
service firebase.storage {
  match /b/{bucket}/o {
    function papel() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role;
    }
    function isMaster() {
      return request.auth.token.get('email', '') == 'junior@spassessoriacontabil.com.br' && request.auth.token.get('email_verified', false) == true;
    }
    function isGestor() {
      return request.auth != null && (isMaster() || papel() == 'gestor');
    }

    match /certificados/{allPaths=**} {
      allow read, list: if isGestor();
      allow write: if false;
    }
    function aprovado() {
      return request.auth != null && (isMaster() || papel() in ['gestor', 'admin', 'colaborador']);
    }
    // PDF das convenções coletivas (Cadastros › Sindicatos): qualquer aprovado lê e envia um novo; nada se
    // sobrescreve nem se apaga (cada envio tem nome próprio).
    match /convencoes/{cnpj}/{arquivo} {
      allow read: if aprovado();
      allow create: if aprovado() && resource == null && cnpj.matches('^[0-9A-Z]{12}[0-9]{2}$')
                    && request.resource.contentType == 'application/pdf'
                    && request.resource.size < 20 * 1024 * 1024;
      allow update, delete: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

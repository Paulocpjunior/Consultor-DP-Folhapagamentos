rules_version = '2';
// O Storage deste projeto só guarda certificados digitais (.pfx). Antes, qualquer
// usuário logado lia e gravava tudo. Agora só admin ou gestor, e o resto fica
// fechado. O cofre único de certificados é o do CFI (etapa do cofre).
service firebase.storage {
  match /b/{bucket}/o {
    function papel() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role;
    }
    function isMaster() {
      return request.auth.token.email == 'junior@spassessoriacontabil.com.br' && request.auth.token.email_verified == true;
    }
    function isAdmin() {
      return request.auth != null && (isMaster() || papel() in ['gestor', 'admin']);
    }

    match /certificados/{allPaths=**} {
      allow read, list, write: if isAdmin();
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
